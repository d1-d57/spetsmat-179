# секреты — никогда в git
secrets/
*.env
!*.env.example

# база и бэкапы
# 🔴 ИСКЛЮЧЕНИЕ, СДЕЛАННОЕ ОСОЗНАННО 2026-09-04 по прямому указанию владельца:
# `data/spetsmat.db` ЗАБИРАЕТСЯ в git. Причина — завтра занятие, и база обязана
# доехать на сервер вместе с кодом. Репозиторий публичный по решению владельца:
# «имена в публичном репозитории не важны, у школы есть сайт со списком класса».
# Резервные копии `REZERV-*.db` и `roster.db` остаются ИСКЛЮЧЁННЫМИ — они не нужны
# на сервере и только раздували бы историю.
data/*
!data/spetsmat.db
backups/
*.db-wal
*.db-shm

# питон
__pycache__/
.venv/
*.pyc
logs/

