# секреты — никогда в git
secrets/
*.env
!*.env.example

# база и бэкапы
# 🔴 НИ ОДНОГО ФАЙЛА БАЗЫ В РЕПОЗИТОРИИ. Решение владельца 10.09, дословно: «нет,
# ни одного». Исключение `!data/spetsmat.db` стояло здесь с 04.09 с причиной
# «завтра занятие» и обошлось дороже, чем помогло.
data/*
# 🔴 ЗАПРЕТ ШИРЕ ПАПКИ `data/`, И ЭТО НЕ ПЕРЕСТРАХОВКА. Правило `data/*` закрывает
# ровно одну папку, а файл базы 10.09 вернулся в репозиторий МЕРЖЕМ ветки позиции —
# то есть путём, который про папку ничего не знал. Резервные копии `REZERV-*.db`
# лежали и вне `data/`. Поэтому запрещается РАСШИРЕНИЕ, где бы файл ни оказался.
*.db
*.sqlite
*.sqlite3
# 🔴 ЖИВАЯ БАЗА В GIT НЕ ЛЕЖИТ (Д1, владелец 10.09:
# «источник истины один — задачи в базе… надо удалить другой неактуальный
# источник, в который ты смотришь, раз и навсегда»).
# ЦЕНА, ЗАМЕРЕНА ВОЛНОЙ УТРО: в свежем worktree выезжала версия БЕЗ миграции 009,
# и сайт там не поднимался вовсе — позиция `gejt-pravda` потеряла на этом целый
# прогон и дважды подменяла базу руками; `data/spetsmat.db` показывалась
# изменённой в рабочей папке КАЖДОЙ из шести позиций; дата ФАЙЛА (12:21 сегодня)
# при отметках по 3 сентября обманула самого оркестратора.
# В git место снимку СХЕМЫ — `data/shema.sql`, — а не записям 53 детей.
# Выкатка базу не возит и не возила: `deploy/vykatka.sh` несёт `--exclude 'data/'`.
!data/shema.sql
backups/
*.db-wal
*.db-shm

# питон
__pycache__/
.venv/
*.pyc
logs/

