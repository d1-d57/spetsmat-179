# секреты — никогда в git
secrets/
*.env
!*.env.example

# база и бэкапы
# 🔴 ИСКЛЮЧЕНИЕ, СДЕЛАННОЕ ОСОЗНАННО 2026-09-04 по прямому указанию владельца:
# `data/spetsmat.db` ЗАБИРАЕТСЯ в git. Причина — завтра занятие, и база обязана
# доехать на сервер вместе с кодом. Репозиторий публичный по решению владельца:
# «имена в публичном репозитории не важны, у школы есть сайт со списком класса».
# Резервные копии `REZERV-*.db` и `roster.db` остаются ИСКЛЮЧЁННЫМИ — они не нужны
# на сервере и только раздували бы историю.
data/*
# 🔴 ЖИВАЯ БАЗА В GIT НЕ ЛЕЖИТ. Исключение `!data/spetsmat.db` стояло здесь с
# причиной «завтра занятие» и обошлось дороже, чем помогло (Д1, владелец 10.09:
# «источник истины один — задачи в базе… надо удалить другой неактуальный
# источник, в который ты смотришь, раз и навсегда»).
# ЦЕНА, ЗАМЕРЕНА ВОЛНОЙ УТРО: в свежем worktree выезжала версия БЕЗ миграции 009,
# и сайт там не поднимался вовсе — позиция `gejt-pravda` потеряла на этом целый
# прогон и дважды подменяла базу руками; `data/spetsmat.db` показывалась
# изменённой в рабочей папке КАЖДОЙ из шести позиций; дата ФАЙЛА (12:21 сегодня)
# при отметках по 3 сентября обманула самого оркестратора.
# В git место снимку СХЕМЫ — `data/shema.sql`, — а не записям 53 детей.
# Выкатка базу не возит и не возила: `deploy/vykatka.sh` несёт `--exclude 'data/'`.
!data/shema.sql
backups/
*.db-wal
*.db-shm

# питон
__pycache__/
.venv/
*.pyc
logs/

