[Unit]
Description=spetsmat veb site (179 school)
Documentation=file://@CHECKOUT@/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TZ=UTC
Environment=PYTHONUNBUFFERED=1
# 🔴 АДРЕС БАЗЫ — ПЕРЕМЕННОЙ, А НЕ ПУТ�ём ОТ КОРНЯ (позиция adres-bazy, 10.09).
# С этой правки `config.DB_PATH` не имеет молчаливого значения по умолчанию: одно имя
# указывало на РАЗНЫЕ файлы на сервере и на машине владельца — и указывало успешно,
# что стоило четырёх ложных докладов владельцу за день. Без переменной служба
# ОТКАЗЫВАЕТСЯ стартовать, и это проверено живьём: сайт без неё не поднимается вовсе.
# Значит она обязана стоять ЗДЕСЬ, иначе первая же выкатка кладёт боевой сайт.
Environment=SPETSMAT_BAZA=@CHECKOUT@/data/spetsmat.db
Environment=SPETSMAT_VEB_ENTRY=${SPETSMAT_VEB_ENTRY:-dummy_entry}
User=@USER@
Group=@USER@
WorkingDirectory=@CHECKOUT@
ExecStart=/usr/bin/python3 -m veb.${SPETSMAT_VEB_ENTRY}
Restart=always
RestartSec=5
# A unit that gives up must say so out loud, like every other unit here: a stop nobody
# hears is no stop.  Missing from this file when it landed -- ops/proverka_ustanovki.py
# caught it, which is the whole reason that check exists.
OnFailure=spetsmat-alert@%n.service
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
