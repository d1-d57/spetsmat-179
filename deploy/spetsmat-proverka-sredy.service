# The environment check: pragmas actually applied, disk not full, root certificates not
# expired, versions adequate.  Every one of these is on the owner's measured list of what
# actually breaks, and every one of them is invisible until it is fatal.

[Unit]
Description=daily environment check
OnFailure=spetsmat-alert@%n.service

[Service]
Type=oneshot
Environment=TZ=UTC
User=@USER@
WorkingDirectory=@CHECKOUT@
ExecStart=/usr/bin/python3 @CHECKOUT@/ops/proverka_sredy.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
