# Скопировать в secrets/bot.env и заполнить. Файл secrets/ в .gitignore.

# Токен от @BotFather. Формат: 1234567890:AAH...
BOT_TOKEN=

# Второй бот — сторож, шлёт уведомления о падениях. Заводится отдельно.
ALERT_TOKEN=
# Ваш telegram id (узнать у @userinfobot)
OWNER_ID=

# --- Разбор ФОТО бланка. Читает bot/app.py:build_vision. ---
# Пусто = разбор фото выключен, бот честно скажет «не настроен» и предложит /setka.
# Провайдер модели. Ровно одно из: openrouter | gemini | openai
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Пусто = модель по умолчанию из infra/llm.py (minimax/minimax-m3:free)
LLM_MODEL=

# --- Распознавание РЕЧИ, Yandex SpeechKit. Читает infra/asr.py:build_transcriber. ---
# Пусто = голосовые выключены: бот ОТКАЖЕТ в расшифровке, а не придумает её.
# Нужны ОБЕ строки — ключ без каталога SpeechKit не работает; заполнена одна,
# и бот скажет, какой второй не хватает.
# Приставка SPETSMAT_ — не украшение: на общей машине переменная с именем ASR_API_KEY
# принадлежит кому угодно, и голос молча ушёл бы в заглушку.
SPETSMAT_ASR_KEY=
SPETSMAT_ASR_FOLDER=
